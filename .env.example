# Copy this file to .env and fill in your own values. Never commit .env.
OPENROUTER_API_KEY=

# Pick a model that accepts IMAGE input from https://openrouter.ai/models
# (filter by "image" input). Paste its id here, e.g. provider/model-name.
OPENROUTER_MODEL=

# Optional settings (defaults shown)
# Where the SQLite database and saved shelf photos are stored:
# DATA_DIR=data
# Detections the model is less sure of than this (0 to 1) are kept apart as "uncertain":
# CONFIDENCE_THRESHOLD=0.5
# Photos are shrunk to this many pixels on the long side before analysis:
# MAX_IMAGE_SIDE=1600
# How much the AI is asked to report: full, lean or minimal. Less detail = shorter answer = faster.
# (lean drops position and attributes; minimal also drops the boxes drawn on the photo.)
# For a public deployment: ask everyone for this password (any username) and cap the daily AI runs
# so strangers cannot spend your OpenRouter credit. 0 means no limit.
# ACCESS_PASSWORD=
# MAX_AUDITS_PER_DAY=50
# How many times the AI looks at each photo (1 to 5, at the same time). More than one uses the
# middle result and shows how much the looks agree. Costs that many times as much.
# DETECT_PASSES=1
# DETAIL_LEVEL=full
# Take a zoomed-in second look at uncertain items (true or false):
# VERIFY_UNCERTAIN=true
# LOG_LEVEL=INFO
